properties:
  file.name:
    displayName: Name
  note.Profession:
    displayName: Role
views:
  - type: table
    name: Table
    filters:
      or:
        - Affiliation.contains("Nighthollow Family")
        - Affiliation.contains("Nighthollow Family (former)")
    order:
      - file.name
      - Status
      - Profession
    sort:
      - property: Status
        direction: ASC
      - property: file.name
        direction: ASC
      - property: Profession
        direction: ASC
  - type: cards
    name: View
    filters:
      and:
        - Affiliation.contains(link("Nighthollow Family"))
    image: note.image
