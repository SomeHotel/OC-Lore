properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Table
    filters:
      and:
        - Affiliation.contains("The Party")
    order:
      - file.name
      - aliases
      - Profession
      - Status
    sort:
      - property: file.name
        direction: ASC
  - type: cards
    name: Party Members
    filters:
      and:
        - Affiliation == ["The Party"]
