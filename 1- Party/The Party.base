properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Table
    filters:
      and:
        - Affiliation.contains("The Party")
    order:
      - file.name
      - aliases
      - Profession
      - Status
    sort: []
  - type: cards
    name: Party Members
    filters:
      and:
        - Affiliation.contains(link("The Party"))
    image: note.image
